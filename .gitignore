# --- Environment & Secrets ---
# Never commit environment files with secrets.
# The .env.example file is an exception and SHOULD be committed.
.env
.env.*
!.env.example

# --- Deployment & Local Overrides ---
# These files are specific to a particular deployment environment (like Portainer)
# or are for local development overrides. They do not belong in the public repo.
docker-compose.portainer.yml
docker-compose.override.yml
deploy.sh

# --- Python ---
# Ignore Python cache files, virtual environments, and compiled files.
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
ENV/

# --- Logs & Data ---
# Ignore runtime log and data directories generated by Docker Compose.
*.log
logs/
app_logs/
caddy_data/
caddy_config/
redis_data/
complete_logs.txt

# --- Build & Distribution Artifacts ---
# Ignore packaging and distribution artifacts.
*.tar
*.gz
dist/
build/
*.egg-info/

# --- IDE / Editor ---
# Ignore common IDE and editor-specific configuration directories.
.vscode/
.idea/
*.swp
*.swo