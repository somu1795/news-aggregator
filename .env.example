# ===================================================================
# News Aggregator Environment Configuration
#
# Copy this file to .env and fill in the values for your environment.
# ===================================================================

# --- Application Configuration ---

# Comma-separated list of hostnames the application will accept requests for.
# This is a critical security setting and must be set.
# Example: ALLOWED_HOSTS=news.example.com,localhost,192.168.1.100
ALLOWED_HOSTS=localhost

# Set to "true" to enable the interactive API documentation at /docs.
# For security, this should be "false" in a production environment.
ENABLE_API_DOCS=false

# --- Security Settings ---

# A secure, secret key to protect administrative endpoints.
# Generate a secure key with a command like: `openssl rand -hex 32`
# This key must be provided in the X-API-Key header for admin requests.
ADMIN_API_KEY=changeme

# Rate limit per client IP, applied to all endpoints.
# Format is "count/period". Periods can be second, minute, hour, day.
API_RATE_LIMIT=100/minute

# --- Performance & Scaling Settings ---

# Number of Uvicorn worker processes to run inside each 'app' container.
# Use one per CPU in APP_CPUS; more workers than CPUs only adds memory.
UVICORN_WORKERS=4

# The maximum number of CPU cores each 'app' container can use.
APP_CPUS=4

# The maximum amount of memory each 'app' container can use (e.g., 512m, 1G, 2G).
APP_MEM_LIMIT=2G

# --- Port & Service Settings ---

# The HTTP port Caddy will listen on. This is the entry point for your reverse proxy.
CADDY_HTTP_PORT=7001

# --- Tagger ---

# Numeric id of the host group that owns the NPU device (/dev/accel/accel0),
# usually "render": find it with `getent group render`.
RENDER_GID=991

# --- Redis ---
# Password for Redis (only reachable inside the Docker network). Required.
# Generate one with: openssl rand -hex 24
REDIS_PASSWORD=

# --- Article Summaries ---
# An Ollama server (https://ollama.com) that summarizes the top articles, e.g. a
# GPU machine on your network: http://<host>:11434. Empty disables summaries.
SUMMARIZER_LLM_URL=
# SUMMARIZER_MODEL=qwen3:8b
