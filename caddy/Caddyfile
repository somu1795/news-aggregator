{
	# Global options block

	# Disable automatic HTTPS as it's handled by the external proxy.
	auto_https off
	servers {
		protocols h1 h2
	}
	cache
	
}

# Define a server that listens only on HTTP port 7001.
:7001 {
	# Log to standard output in a structured JSON format.
	log {
		output stdout
		format json
	}
	encode zstd gzip

	# Cache GET requests for the homepage for 5 minutes to reduce backend load.
	@home path /
	cache @home 5m

	# Reverse proxy all other requests to the 'app' service.
	# Caddy automatically discovers and load-balances across all scaled 'app' containers.
	reverse_proxy app:8989 {
		# Use a round-robin load balancing strategy for even distribution.
		lb_policy round_robin

		# Trust the incoming X-Forwarded-* headers from our external proxy.
		# Replace the first subnet with your LAN range at deploy time.
		trusted_proxies private_ranges

		# Actively check the health of backend containers and stop sending
		# traffic to unhealthy ones.
		health_uri      /health
		health_interval 10s
		health_headers {
			Host "localhost"
		}
	}
}