{
	# Global options block

	# Disable automatic HTTPS: Cloudflare terminates TLS and reaches Caddy through the tunnel.
	auto_https off
	servers {
		protocols h1 h2

		# Only these peers may tell us the real client IP: private ranges (the Docker network,
		# where the Cloudflare Tunnel connector connects from, and the LAN). Forwarded headers
		# from anyone else are ignored, so other clients can't spoof their IP.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Real-IP X-Forwarded-For
	}
}

# Define a server that listens only on HTTP port 7001.
:7001 {
	# Log to standard output in a structured JSON format, without what visitors search
	# (the q of /api/search; the app's own access log drops it too)
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete q
				}
			}
		}
	}
	encode zstd gzip

	# Security headers (the page also gets a Content-Security-Policy from the app)
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Prometheus metrics: only for this machine and the LAN, connecting directly. Visitors come
	# through the Cloudflare Tunnel, whose connector is on the (private) Docker network too, so
	# they're told apart by the header Cloudflare adds to every request.
	@metrics_via_cloudflare {
		path /metrics
		header Cf-Connecting-IP *
	}
	@metrics_from_outside {
		path /metrics
		not remote_ip private_ranges
	}
	respond @metrics_via_cloudflare "Forbidden" 403
	respond @metrics_from_outside "Forbidden" 403

	# Site icons are static files baked into this image (caddy/static); the app serves the manifest (site.yaml)
	@icons path /favicon.svg /favicon.ico /apple-touch-icon.png /icon-192.png /icon-512.png
	handle @icons {
		root * /srv/static
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# The stats page: static files baked into this image, and the heatmap the stats service
	# writes to a shared volume. Neither touches the app or the stats service.
	redir /stats /stats/ 308
	@stats path /stats/*
	header @stats {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
	}
	handle /stats/heatmap.json {
		root * /srv/stats-data
		uri strip_prefix /stats
		header Cache-Control "public, max-age=60"
		file_server
	}
	handle @stats {
		root * /srv/static
		header Cache-Control "public, max-age=300"
		file_server
	}

	# Reverse proxy all other requests to the 'app' service.
	# Caddy automatically discovers and load-balances across all scaled 'app' containers.
	reverse_proxy app:8989 {
		# Use a round-robin load balancing strategy for even distribution.
		lb_policy round_robin

		# Overwrite any client-supplied value with the IP resolved above.
		# The app rate-limits on this header.
		header_up X-Real-IP {client_ip}

		# Actively check the health of backend containers and stop sending
		# traffic to unhealthy ones.
		health_uri      /health
		health_interval 10s
		health_headers {
			Host "localhost"
		}
	}
}
