{
	# Global options block

	# Disable automatic HTTPS: Cloudflare terminates TLS and reaches Caddy through the tunnel.
	auto_https off
	servers {
		protocols h1 h2

		# Only these peers may tell us the real client IP: private (Docker) ranges, where
		# the Cloudflare Tunnel connector connects from. Forwarded headers from anyone else
		# are ignored, so clients that reach this port directly cannot spoof their IP.
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP X-Real-IP X-Forwarded-For
	}
}

# Define a server that listens only on HTTP port 7001.
:7001 {
	# Log to standard output in a structured JSON format.
	log {
		output stdout
		format json
	}
	encode zstd gzip

	# Security headers (the page also gets a Content-Security-Policy from the app)
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Block external access to Prometheus metrics
	@metrics path /metrics
	respond @metrics "Forbidden" 403

	# Site icons and the web app manifest are static files baked into this image (caddy/static)
	@icons path /favicon.svg /favicon.ico /apple-touch-icon.png /icon-192.png /icon-512.png
	handle @icons {
		root * /srv/static
		header Cache-Control "public, max-age=604800"
		file_server
	}
	handle /manifest.webmanifest {
		root * /srv/static
		header Content-Type application/manifest+json
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Reverse proxy all other requests to the 'app' service.
	# Caddy automatically discovers and load-balances across all scaled 'app' containers.
	reverse_proxy app:8989 {
		# Use a round-robin load balancing strategy for even distribution.
		lb_policy round_robin

		# Overwrite any client-supplied value with the IP resolved above.
		# The app rate-limits on this header.
		header_up X-Real-IP {client_ip}

		# Actively check the health of backend containers and stop sending
		# traffic to unhealthy ones.
		health_uri      /health
		health_interval 10s
		health_headers {
			Host "localhost"
		}
	}
}
