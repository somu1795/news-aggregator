<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>News</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville&display=swap');

    body {
      font-family: 'Libre Baskerville', serif;
      margin: 0;
      padding: 2rem;
      background-color: #fefefe;
      color: #222;
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    h1 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    ul {
      list-style-type: none;
      padding: 0;
      max-width: 700px;
      width: 100%;
    }

    li {
      margin: 1rem 0;
      font-size: 1.1rem;
    }

    a {
      color: #1a0dab;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    .dark-mode {
      background-color: #111;
      color: #eee;
    }

    .dark-mode a {
      color: #80bfff;
    }

    .toggle-btn {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: 36px;
      height: 36px;
      border: none;
      background-color: #ddd;
      border-radius: 50%;
      font-size: 18px;
      cursor: pointer;
    }

    .dark-mode .toggle-btn {
      background-color: #444;
      color: #fff;
    }
  </style>
</head>
<body>
  <button class="toggle-btn" onclick="toggleDarkMode()">🌙</button>
  <h1>News</h1>
  <ul id="headlines"></ul>

  <script>
    function toggleDarkMode() {
      const body = document.body;
      body.classList.toggle('dark-mode');
      const btn = document.querySelector('.toggle-btn');
      btn.textContent = body.classList.contains('dark-mode') ? '☀️' : '🌙';
    }

    async function loadHeadlines() {
      const res = await fetch('/api/headlines');
      const headlines = await res.json();
      const ul = document.getElementById('headlines');
      ul.innerHTML = headlines.map(h =>
        `<li><a href="${h.link}" target="_blank" rel="noopener noreferrer">${h.title}</a></li>`
      ).join('');
    }

    loadHeadlines();
    setInterval(loadHeadlines, 60000);
  </script>
</body>
</html>
